class Test {
    public int pub_var;
    protected int prot_var;
    private int priv_var;

    public Test(int c) {
        WriteLine('1');
        WriteLine('c');
        WriteLine(c);
        pub_var = c;
    }

    private void hidden_func() {
        pub_var = 14;
    }

    protected int double() {
        return prot_var  * 2;
    }
}

class TestTest : Test {
    public TestTest(int a, int b): base(a) {
        WriteLine('2');
        WriteLine('a');
        WriteLine(a);
        prot_var = b;
    }

    public int triple() {
        return double() + prot_var;
    }
}

class TestTestTest : TestTest {
    public TestTestTest(int a, int b, int c) : base(a, b) {
        WriteLine('3');
        WriteLine('a');
        WriteLine(a);
        WriteLine('b');
        WriteLine(b);
        WriteLine('c');
        WriteLine(c);
    }
}



class Program {    
    public int main() {
        TestTestTest testTestTest = new TestTestTest(20, 30, 40);
        WriteLine('t');
        WriteLine(testTestTest.triple());
        return 1;
    }
}
