class Weapon {
    protected int dmg;

    public Weapon(int d) {
        dmg = d;
    }

    public int attack() {
        return dmg;
    }
}

class Sword : Weapon {
    public Sword(): base(20) {

    }
}

class Axe : Weapon {
    public Axe(): base(30) {
        
    }
}

class Bow : Weapon {
    public Bow(): base(5) {

    }
}

class Entity {
    protected int hp;

    public Entity(int baseHp) {
        hp = baseHp;
    }

    public bool isAlive() {
        if (hp > 0) {
            return true;
        }
        else {
            return false;
        }
    }

    public void heal(int healPoints) {
        hp = hp + healPoints;
    }

    public void attack(int dmg) {
        hp = hp - dmg;
    }

}

class Enemy : Entity {
    public Weapon weapon;

    public Enemy(Weapon w) : base(100) {
        weapon = w;
    }

    public int getDmg() {
        return weapon.attack();
    }
}

class Swordsman : Enemy {
    public Swordsman() : base(new Sword()) {
        
    }

    public void attack(int dmg) {
        int reducedDmg = (dmg / 10) * 8;
        hp = hp - reducedDmg;
    }

}

class Bowman : Enemy {
    public Bowman() : base(new Bow()) {
        
    }
}

class Axeman : Enemy {
    public Axeman() : base(new Axe()) {

    }
}


class Player : Entity {
    public Weapon weapon;
    public char name = 'p';
    
    public Player() : base(100) {
        weapon = new Sword();
    }

    public int getDmg() {
        return weapon.attack();
    }

}

class Program {    
    public int main() {
        Player player = new Player();
        WriteLine(player.name);
        WriteLine(player.isAlive());
        List<Enemy> enemies = [];

        for (int s = 0; s < 3; s = s + 1) {
            Swordsman enemy = new Swordsman();
            enemies.Add(enemy);
        }

        for (int b = 0; b < 2; b = b + 1) {
            Bowman enemy = new Bowman();
            enemies.Add(enemy);
        }

        for (int a = 0; a < 2; a = a + 1) {
            Axeman enemy = new Axeman();
            enemies.Add(enemy);
        }

        enemies.Shuffle();

        #enemies[0].attack(20);
        for (int i = 0; i < enemies.Count; i = i + 1) {
            #enemies[i].attack(player.getDmg());
            #WriteLine(enemies[i].isAlive());
        }


        #WriteLine(player.weapon.attack());
        return 1;
    }
}
